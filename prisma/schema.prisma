// Doctor-Radio data model. See docs/ARCHITECTURE.md §2.
// Conventions: cuid ids, createdAt/updatedAt everywhere, soft-delete (deletedAt) on user content.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ───────────────────────── Enums ─────────────────────────

enum Role {
  MEMBER
  MODERATOR
  ADMIN
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

enum Designation {
  STUDENT
  PG1
  PG2
  PG3
  FELLOW
  CONSULTANT
  FACULTY
}

enum VerificationStatus {
  UNVERIFIED
  PENDING
  VERIFIED
  REJECTED
}

enum Modality {
  CT
  MRI
  XRAY
  ULTRASOUND
  MAMMOGRAPHY
  PET_CT
  OTHER
}

enum Difficulty {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum CaseStatus {
  DRAFT
  PROCESSING
  PENDING_REVIEW
  PUBLISHED
  REJECTED
  REMOVED
}

enum FileKind {
  IMAGE
  PDF
  DICOM
  ARCHIVE
}

enum FileScanStatus {
  PENDING
  CLEAN
  INFECTED
  REJECTED
}

enum ConfidenceLevel {
  LOW
  MODERATE
  HIGH
}

enum ReportTargetType {
  CASE
  COMMENT
  OBSERVATION
  USER
}

enum ReportStatus {
  OPEN
  REVIEWING
  RESOLVED
  DISMISSED
}

enum ModerationActionType {
  APPROVE_CASE
  REJECT_CASE
  REMOVE_CONTENT
  RESTORE_CONTENT
  SUSPEND_USER
  REINSTATE_USER
  VERIFY_USER
  REJECT_VERIFICATION
  DISMISS_REPORT
}

enum NotificationType {
  REPLY
  MENTION
  NEW_OBSERVATION
  NEW_FOLLOWER
  CASE_APPROVED
  CASE_REJECTED
  VERIFICATION_UPDATE
  ACHIEVEMENT
  SYSTEM
}

enum AIMessageRole {
  USER
  ASSISTANT
}

// ───────────────────────── Identity ─────────────────────────

model User {
  id            String        @id @default(cuid())
  email         String        @unique
  emailVerified DateTime?
  passwordHash  String? // null for Google-only accounts
  name          String?
  image         String?
  role          Role          @default(MEMBER)
  status        AccountStatus @default(ACTIVE)
  failedLogins  Int           @default(0)
  lockedUntil   DateTime?
  lastLoginAt   DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  profile       UserProfile?
  accounts      Account[]
  sessions      Session[]
  resetTokens   PasswordResetToken[]
  verifications VerificationRequest[]

  cases         Case[]
  observations  Observation[]
  comments      Comment[]
  likes         Like[]
  bookmarks     Bookmark[]
  reveals       ObservationReveal[]
  helpfulMarks  ObservationHelpful[]
  followers     Follow[]       @relation("Following")
  following     Follow[]       @relation("Follower")
  notifications Notification[] @relation("NotificationRecipient")
  notificationsSent Notification[] @relation("NotificationActor")
  aiConversations AIConversation[]
  achievements  UserAchievement[]
  pointEvents   PointEvent[]
  reportsFiled  Report[]       @relation("Reporter")
  moderationActions ModerationAction[] @relation("Moderator")
  auditLogs     AuditLog[]

  @@index([role])
  @@index([status])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique // sha256 of the emailed token; raw token never stored
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Institution {
  id        String   @id @default(cuid())
  name      String
  city      String?
  state     String?
  country   String   @default("India")
  createdAt DateTime @default(now())

  profiles UserProfile[]

  @@unique([name, city])
}

model UserProfile {
  id             String      @id @default(cuid())
  userId         String      @unique
  username       String      @unique
  displayName    String
  designation    Designation
  qualification  String? // e.g. "MD Radiodiagnosis"
  pgYear         Int? // 1-3 where relevant
  yearsExperience Int?
  institutionId  String?
  bio            String?     @db.VarChar(600)
  interests      String[] // body regions / subspecialties
  avatarUrl      String?
  // Professional verification
  verificationStatus VerificationStatus @default(UNVERIFIED)
  verifiedAt         DateTime?
  // Denormalised counters (updated transactionally)
  points         Int         @default(0)
  streakDays     Int         @default(0)
  lastActiveOn   DateTime?   @db.Date
  onboardingDone Boolean     @default(false)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  institution Institution? @relation(fields: [institutionId], references: [id], onDelete: SetNull)

  @@index([designation])
  @@index([institutionId])
  @@index([points])
}

model VerificationRequest {
  id             String             @id @default(cuid())
  userId         String
  registrationNo String? // medical council registration number
  council        String?
  documentKey    String? // private object-storage key
  status         VerificationStatus @default(PENDING)
  reviewerNote   String?
  reviewedById   String?
  reviewedAt     DateTime?
  createdAt      DateTime           @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status, createdAt])
}

// ───────────────────────── Social ─────────────────────────

model Follow {
  followerId  String
  followingId String
  createdAt   DateTime @default(now())

  follower  User @relation("Follower", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("Following", fields: [followingId], references: [id], onDelete: Cascade)

  @@id([followerId, followingId])
  @@index([followingId])
}

model Notification {
  id          String           @id @default(cuid())
  recipientId String
  actorId     String?
  type        NotificationType
  caseId      String?
  commentId   String?
  message     String
  readAt      DateTime?
  createdAt   DateTime         @default(now())

  recipient User  @relation("NotificationRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  actor     User? @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([recipientId, readAt, createdAt])
}

// ───────────────────────── Cases ─────────────────────────

model Case {
  id              String     @id @default(cuid())
  authorId        String
  title           String     @db.VarChar(200)
  modality        Modality
  bodyRegion      String
  category        String?
  clinicalHistory String     @db.Text
  patientAgeRange String?
  clinicalInfo    String?    @db.Text
  imagingFindings String?    @db.Text
  difficulty      Difficulty @default(INTERMEDIATE)
  status          CaseStatus @default(DRAFT)
  // Learning-mode: author's reference answer, hidden until discussion matures
  finalDiagnosis  String?
  // Mandatory publication gates
  deidConfirmedAt DateTime?
  authorizationConfirmedAt DateTime?
  consentTextVersion String?
  reviewedById    String?
  reviewedAt      DateTime?
  rejectionReason String?
  publishedAt     DateTime?
  // Denormalised counters
  likeCount        Int @default(0)
  commentCount     Int @default(0)
  observationCount Int @default(0)
  bookmarkCount    Int @default(0)
  viewCount        Int @default(0)
  lastActivityAt   DateTime @default(now())
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  deletedAt       DateTime?

  author       User          @relation(fields: [authorId], references: [id])
  files        CaseFile[]
  tags         CaseTag[]
  observations Observation[]
  comments     Comment[]
  likes        Like[]
  bookmarks    Bookmark[]
  aiConversations AIConversation[]
  deidReports  DeidentificationReport[]
  reveals      ObservationReveal[]

  @@index([status, publishedAt(sort: Desc)])
  @@index([modality, bodyRegion])
  @@index([difficulty])
  @@index([authorId])
  @@index([observationCount])
  @@index([lastActivityAt])
}

model CaseFile {
  id          String         @id @default(cuid())
  caseId      String
  kind        FileKind
  storageKey  String         @unique // private bucket key, never exposed directly
  thumbKey    String?
  originalName String
  mimeType    String
  sizeBytes   BigInt
  sha256      String
  position    Int            @default(0)
  scanStatus  FileScanStatus @default(PENDING)
  selected    Boolean        @default(true) // chosen for publication from extracted archive
  // DICOM
  dicomMeta   Json? // sanitised (post de-id) metadata only
  sliceCount  Int?
  parentFileId String? // set for files extracted from an archive
  createdAt   DateTime       @default(now())

  case Case @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([caseId, position])
}

model Tag {
  id    String    @id @default(cuid())
  name  String    @unique
  cases CaseTag[]
}

model CaseTag {
  caseId String
  tagId  String

  case Case @relation(fields: [caseId], references: [id], onDelete: Cascade)
  tag  Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([caseId, tagId])
  @@index([tagId])
}

model DeidentificationReport {
  id        String   @id @default(cuid())
  caseId    String
  fileId    String?
  // [{ tag: "PatientName", action: "removed" | "flagged" }, ...]
  findings  Json
  burnedInTextSuspected Boolean @default(false)
  resolved  Boolean  @default(false)
  createdAt DateTime @default(now())

  case Case @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([caseId])
}

// ───────────────────────── Collaboration ─────────────────────────

model Observation {
  id          String           @id @default(cuid())
  caseId      String
  authorId    String
  findings    String           @db.Text
  impression  String?          @db.Text
  comments    String?          @db.Text // "additional comments"
  imagingSigns String[]
  references  String?          @db.Text
  confidence  ConfidenceLevel?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  editedAt    DateTime?
  deletedAt   DateTime?

  case          Case                    @relation(fields: [caseId], references: [id], onDelete: Cascade)
  author        User                    @relation(fields: [authorId], references: [id])
  differentials DifferentialDiagnosis[]
  discussion    Comment[]
  helpful       ObservationHelpful[]

  // Each member keeps exactly one observation per case; others never overwrite it.
  @@unique([caseId, authorId])
  @@index([caseId, createdAt])
}

model DifferentialDiagnosis {
  id            String  @id @default(cuid())
  observationId String
  diagnosis     String
  rationale     String? @db.Text
  rank          Int     @default(0)

  observation Observation @relation(fields: [observationId], references: [id], onDelete: Cascade)

  @@index([observationId])
}

// Tracks that a user has opted to reveal others' observations (after submitting, or explicitly skipping).
model ObservationReveal {
  userId    String
  caseId    String
  skipped   Boolean  @default(false) // true = explored without submitting first
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  case Case @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@id([userId, caseId])
}

// Hierarchical: parentId builds threads. A comment belongs to a case, optionally to an observation.
model Comment {
  id            String    @id @default(cuid())
  caseId        String
  observationId String?
  parentId      String?
  authorId      String
  body          String    @db.Text // markdown, sanitised on render
  likeCount     Int       @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  editedAt      DateTime?
  deletedAt     DateTime?

  case        Case         @relation(fields: [caseId], references: [id], onDelete: Cascade)
  observation Observation? @relation(fields: [observationId], references: [id], onDelete: Cascade)
  parent      Comment?     @relation("Thread", fields: [parentId], references: [id], onDelete: Cascade)
  replies     Comment[]    @relation("Thread")
  author      User         @relation(fields: [authorId], references: [id])
  likes       Like[]

  @@index([caseId, createdAt])
  @@index([observationId, createdAt])
  @@index([parentId])
}

// A like targets exactly one of case/comment (enforced by CHECK constraint in migration).
model Like {
  id        String   @id @default(cuid())
  userId    String
  caseId    String?
  commentId String?
  createdAt DateTime @default(now())

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  case    Case?    @relation(fields: [caseId], references: [id], onDelete: Cascade)
  comment Comment? @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@unique([userId, caseId])
  @@unique([userId, commentId])
  @@index([caseId])
  @@index([commentId])
}

model Bookmark {
  userId    String
  caseId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  case Case @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@id([userId, caseId])
  @@index([caseId])
}

// ───────────────────────── AI ─────────────────────────

model AIConversation {
  id        String   @id @default(cuid())
  userId    String
  caseId    String?
  provider  String
  model     String
  createdAt DateTime @default(now())

  user     User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  case     Case?       @relation(fields: [caseId], references: [id], onDelete: SetNull)
  messages AIMessage[]

  @@index([userId, createdAt])
  @@index([caseId])
}

// Covers both prompts and "AIResponses". All ASSISTANT rows are AI-generated by definition
// and are never public; `adoptedAsObservationId` is set only after explicit human action.
model AIMessage {
  id             String        @id @default(cuid())
  conversationId String
  role           AIMessageRole
  content        String        @db.Text
  task           String? // summarize | explain | differentials | quiz | flashcards | compare ...
  inputTokens    Int?
  outputTokens   Int?
  phiGuardPassed Boolean       @default(true)
  adoptedAsObservationId String?
  createdAt      DateTime      @default(now())

  conversation AIConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

// ───────────────────────── Gamification ─────────────────────────

model Achievement {
  id          String @id @default(cuid())
  key         String @unique
  name        String
  description String
  icon        String

  users UserAchievement[]
}

model UserAchievement {
  userId        String
  achievementId String
  awardedAt     DateTime @default(now())

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievement Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)

  @@id([userId, achievementId])
}

// Points are quality-weighted (e.g. peer-marked helpful), not volume-weighted.
model PointEvent {
  id        String   @id @default(cuid())
  userId    String
  reason    String
  points    Int
  refId     String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([createdAt])
}

// ───────────────────────── Governance ─────────────────────────

model Report {
  id         String           @id @default(cuid())
  reporterId String
  targetType ReportTargetType
  targetId   String
  reason     String
  details    String?          @db.Text
  status     ReportStatus     @default(OPEN)
  createdAt  DateTime         @default(now())
  resolvedAt DateTime?

  reporter User @relation("Reporter", fields: [reporterId], references: [id], onDelete: Cascade)

  @@unique([reporterId, targetType, targetId])
  @@index([status, createdAt])
  @@index([targetType, targetId])
}

model ModerationAction {
  id          String               @id @default(cuid())
  moderatorId String
  type        ModerationActionType
  targetType  String
  targetId    String
  reason      String?
  createdAt   DateTime             @default(now())

  moderator User @relation("Moderator", fields: [moderatorId], references: [id])

  @@index([targetType, targetId])
  @@index([moderatorId, createdAt])
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  action    String // e.g. "auth.login", "case.publish", "user.suspend"
  entity    String?
  entityId  String?
  ip        String?
  userAgent String?
  metadata  Json?
  createdAt DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId, createdAt])
  @@index([action, createdAt])
  @@index([entity, entityId])
}

// Peer-rated usefulness of an observation. Drives quality-weighted points (not volume).
model ObservationHelpful {
  observationId String
  userId        String
  createdAt     DateTime @default(now())

  observation Observation @relation(fields: [observationId], references: [id], onDelete: Cascade)
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([observationId, userId])
  @@index([userId])
}

// Runtime-editable configuration (e.g. LLM provider). Secrets are stored encrypted (AES-256-GCM).
model AppSetting {
  key         String   @id
  value       String   @db.Text
  updatedById String?
  updatedAt   DateTime @updatedAt
}
