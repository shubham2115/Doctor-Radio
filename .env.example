# Copy to .env and fill in. Never commit .env.
DATABASE_URL="postgresql://radio:radio@localhost:5432/doctor_radio?schema=public"
REDIS_URL="redis://localhost:6379"

# Auth.js — generate with: npx auth secret
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# S3-compatible storage (MinIO locally) — Phase 2
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_BUCKET="doctor-radio-private"
S3_ACCESS_KEY=""
S3_SECRET_KEY=""

# LLM — optional fallback. Admins normally set provider + API key in the app: Moderation → AI settings (stored encrypted in the DB).
# Providers: openai | anthropic | gemini | cohere | openai-compatible
LLM_PROVIDER="anthropic"
LLM_MODEL=""
LLM_API_KEY=""
LLM_BASE_URL=""

# Email (password reset). Leave blank in dev: link is logged to console.
SMTP_URL=""
EMAIL_FROM="Doctor Radio <no-reply@example.com>"

# Case pipeline (Phase 2)
STORAGE_DIR=".storage"
# ClamAV (clamd) for malware scanning. Without it files stay "PENDING" and moderators can't approve
# unless ALLOW_UNSCANNED=true (development only!).
CLAMAV_HOST=""
CLAMAV_PORT="3310"
ALLOW_UNSCANNED="false"
